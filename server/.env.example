APP_NAME=NexVision Reasoning RAG AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_JWKS_URL=
DEV_BYPASS_USER_ID=
DEBUG_LOGS=false
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_VECTOR_TABLE=document_chunks

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Document processing (optional — defaults shown)
CHUNK_SIZE=200
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5